# Okoljske spremenljivke Domačije Tešlan (načrt §8).
# Kopirajte v .env.local in izpolnite. Vrednosti nikoli ne commitajte.
# Preverja jih src/env.ts ob zagonu strežnika; prazno pomeni nenastavljeno.

# --- Baza in Payload (od K3) ---  obvezni v produkciji in na stagingu
# Lokalno: Postgres v Dockerju (docker compose up -d), postgres://teslan:teslan@localhost:5432/teslan
DATABASE_URL=
# Naključna vrednost, vsaj 32 znakov (openssl rand -hex 32), drugačna za vsako okolje.
PAYLOAD_SECRET=
# Neobvezno: baza za teste (Vitest, Playwright), ki jo testi sami izpraznijo; ime se mora končati s _test.
# Privzeto postgres://teslan:teslan@localhost:5432/teslan_test
TEST_DATABASE_URL=

# --- Spletno mesto ---
# Staging: Railway URL; produkcija: https://www.teslan.si
NEXT_PUBLIC_SITE_URL=
# "1" na stagingu (noindex, /styleguide, oznaka osnutka na pravnih straneh); v produkciji ni nastavljeno.
NOINDEX=
# Basic Auth za staging (obe ali nobena); /api/stripe/webhook je izvzet.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- Stripe (K8) ---  brez ključev se Stripe testi preskočijo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- E-pošta prek Resend (K9) ---  brez ključa se e-pošta izpiše v log
RESEND_API_KEY=
EMAIL_FROM=
# Na stagingu: vsa pošta gre na ta naslov; v produkciji ni nastavljeno.
EMAIL_REDIRECT_TO=
# Samo za teste (Playwright): brez Resenda se vsaka e-pošta doda še v to datoteko (JSONL).
EPOSTA_DNEVNIK=

# --- Blagajna (K7) ---
# Neobvezno: največ toliko naročil z enega IP v 10 minutah (privzeto 5). Višje samo za teste.
OMEJITEV_NAROCIL_NA_IP=

# --- Cloudflare R2 prek S3 API (K3) ---  vse ali nič; brez njih se slike shranjujejo na lokalni disk
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Seed (K4) ---  prvi admin (npm run seed, pred deployem seed:if-empty); ustvari se le, če ni nobenega uporabnika
# Obe ali nobena; geslo vsaj 12 znakov. Brez njiju se prvi admin ustvari na /admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
